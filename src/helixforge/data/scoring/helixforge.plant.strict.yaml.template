# HelixForge strict (high-precision) Mikado scoring profile, TEMPLATE.
#
# IMPORTANT: This is a starting skeleton. The Mikado scoring-file schema has changed across
# minor versions. Before trusting this, generate the shipped plant profile for your PINNED
# Mikado and diff against it:
#     mikado configure --scoring plant.yaml --reference genome.fa /dev/null _tmp.yaml
# then copy the real `plant.yaml` from the Mikado install and adapt it. Keep the metric NAMES
# exactly as Mikado expects for your version. HelixForge's mikado/config.py writes the final
# file; this template documents intent (see docs/DESIGN.md §7).
#
# Two profiles are expected in this directory:
#   helixforge.plant.strict.yaml      (this one, precision-leaning, for the reproducibility story)
#   helixforge.plant.permissive.yaml  (higher isoform recall, copy + relax as_requirements + ccodes)
#
# NOTE: which knob lives where,
#   * requirements / cds_requirements / as_requirements / not_fragmentary / scoring  -> THIS file
#   * pick/alternative_splicing (report, pad, valid_ccodes, min_*_overlap, max_isoforms,
#     keep_retained_introns), chimera_split, flank                                    -> configuration.yaml
#   HelixForge's config.py sets both consistently.

# ---------------------------------------------------------------------------
# Hard locus-entry requirements: transcripts failing these are excluded outright.
# ---------------------------------------------------------------------------
requirements:
  expression:
    - ((exon_num.multi and (cdna_length.multi or combined_cds_length.multi)) or (exon_num.mono and combined_cds_length.mono))
    - and (proportion_verified_introns_inlocus.multi or exon_num.mono)
  parameters:
    cdna_length.mono: {operator: ge, value: 200}
    cdna_length.multi: {operator: ge, value: 300}
    combined_cds_length.mono: {operator: ge, value: 150}
    combined_cds_length.multi: {operator: ge, value: 150}
    exon_num.mono: {operator: eq, value: 1}
    exon_num.multi: {operator: gt, value: 1}
    # multi-exon transcripts must have at least one junction-verified intron:
    proportion_verified_introns_inlocus.multi: {operator: gt, value: 0}

# ORF coherence requirements (keeps coding models honest).
cds_requirements:
  expression:
    - combined_cds_length
  parameters:
    combined_cds_length: {operator: ge, value: 150}

# ---------------------------------------------------------------------------
# Alternative-splicing admission: an alternative isoform must clear these to be retained.
# This is the direct fix for v2's "redundant isoforms under a numeric cap".
# (valid_ccodes, min overlaps, pad, max_isoforms also set in configuration.yaml/pick.)
# ---------------------------------------------------------------------------
as_requirements:
  expression:
    - cdna_length and three_utr_length and five_utr_length and utr_length and suspicious_splicing
  parameters:
    cdna_length: {operator: ge, value: 200}
    utr_length: {operator: le, value: 2500}
    five_utr_length: {operator: le, value: 2500}
    three_utr_length: {operator: le, value: 2500}
    suspicious_splicing: {operator: ne, value: true}

# Fragment detection: drop locus fragments near better loci.
not_fragmentary:
  expression:
    - ((exon_num.multi and (combined_cds_length.multi)) or (exon_num.mono and combined_cds_length.mono))
  parameters:
    exon_num.mono: {operator: eq, value: 1}
    exon_num.multi: {operator: gt, value: 1}
    combined_cds_length.mono: {operator: gt, value: 300}
    combined_cds_length.multi: {operator: gt, value: 250}

# ---------------------------------------------------------------------------
# Scoring metrics (representative selection). rescaling: max -> higher is better,
# min -> lower is better, target -> closeness to `value`. multiplier = weight.
# External metrics (HDF5-derived) injected by serialise --external-scores are referenced
# as external.<name> and MUST be in [0,1].
# ---------------------------------------------------------------------------
scoring:
  # RNA-seq junction support: the strongest structural signal (replaces v2 weight_junction).
  proportion_verified_introns_inlocus: {rescaling: max, multiplier: 4}
  verified_introns_num: {rescaling: max, multiplier: 2}
  non_verified_introns_num: {rescaling: min, multiplier: 2}

  # Coding completeness / ORF quality.
  combined_cds_length: {rescaling: max, multiplier: 3}
  selected_cds_fraction: {rescaling: max, multiplier: 2}
  cds_not_maximal: {rescaling: min, multiplier: 1}
  cds_not_maximal_fraction: {rescaling: min, multiplier: 1}
  five_utr_length: {rescaling: target, value: 200, multiplier: 1}
  three_utr_length: {rescaling: target, value: 400, multiplier: 1}
  end_distance_from_junction: {rescaling: min, multiplier: 1}

  # Intron-retention penalty: the dominant StringTie noise mode (pre-mRNA).
  retained_intron_num: {rescaling: min, multiplier: 3}
  retained_fraction: {rescaling: min, multiplier: 2}

  # Structure.
  exon_num: {rescaling: max, multiplier: 1, filter: {operator: ge, value: 1}}
  canonical_intron_proportion: {rescaling: max, multiplier: 2}

  # Protein homology (replaces v2 weight_protein).
  blast_score: {rescaling: max, multiplier: 3}

  # HelixForge external metrics: the Helixer deep-learning prior (replaces v2 weight_confidence).
  # These are the novel coupling. Tune multipliers during Phase 11 ablations.
  external.helixer_support: {rescaling: max, multiplier: 3}
  external.helixer_locus_conf: {rescaling: max, multiplier: 1}
  # Optional expression metric if loaded:
  external.tpm: {rescaling: max, multiplier: 2}
