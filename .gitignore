# Keep small test fixtures that are generated in code, not committed binaries.
# If you must commit a tiny fixture, put it under tests/ and force-add it:
#   git add -f tests/data/tiny.gff3
!tests/**/*.gff3
!tests/**/*.gtf

# v4 / poster generated outputs, benchmarks, ablations, and tool downloads
# (never commit — multi-GB generated artifacts) EXCEPT the small result tables the
# poster docs/figures trace to (CLAUDE.md §16 F3: numbers regenerate from committed files).
ablation_out/*
!ablation_out/ablation.tsv
bench_out/*
!bench_out/benchmark.tsv
!bench_out/iso_trace.result.json
!bench_out/iso_noTRACE.result.json
bench_out_m7a/*
!bench_out_m7a/results_gffcompare_mikado_compare_compleasm_both.tsv
m3_out_trace/
m3_out_trace*/
m5_out/
scale/
realize_function/
realize_function_mock/
realize_miniprot/
realize_ncrna/
realize_organellar/
